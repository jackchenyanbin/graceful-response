# EditorConfig - https://editorconfig.org
# 配合 IntelliJ IDEA / VS Code 的 EditorConfig 插件使用

root = true

# ========================
# 通用配置（所有文件）
# ========================
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# ========================
# Java 源码
# ========================
[*.java]
indent_size = 4
# 对应 Google Java Format AOSP 风格：4空格缩进、120字符行宽
max_line_length = 120

# ========================
# XML（pom.xml 等）
# ========================
[*.xml]
indent_size = 4

# ========================
# YAML / Properties
# ========================
[*.{yml,yaml}]
indent_size = 2

[*.properties]
indent_size = 4

# ========================
# Markdown
# ========================
[*.md]
trim_trailing_whitespace = false

# ========================
# JSON
# ========================
[*.json]
indent_size = 2

# ========================
# Makefile（必须用 tab）
# ========================
[Makefile]
indent_style = tab
